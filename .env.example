# ========================================================
# Issue Tracker Pro - Environment Variables Configuration
# ========================================================

# Database Connection (MySQL / MariaDB / PlanetScale / Aiven)
DATABASE_URL="mysql://username:password@host:3306/issue_tracker"
SHADOW_DATABASE_URL="mysql://username:password@host:3306/issue_tracker_shadow"

# NextAuth Configuration
# Generate a secret via: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-secret-key-goes-here"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (Optional - Leave empty to use Email/Password Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Assistant Configuration (Optional)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
